# ── LLM Provider API Keys (Free Tier / Optional) ─────────────────────────
# If set, ShadowLens uses live LLM tool calling.
# If omitted, ShadowLens runs in deterministic Autonomous Graph Planner mode.
GEMINI_API_KEY=your-gemini-key-here
GROQ_API_KEY=your-groq-key-here
OPENAI_API_KEY=your-openai-key-here

# ── Graph Layer (Neo4j or In-Memory NetworkX) ─────────────────────────────────
# To use dedicated Neo4j:
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=shadowlens_password
#
# If NEO4J_URI is omitted or unreachable, ShadowLens automatically runs
# with the zero-dependency InMemoryGraphStore (NetworkX engine).
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=shadowlens_password

# ── MongoDB (Optional) ────────────────────────────────────────────────────────
# MongoDB is optional; runs in memory-first mode if disconnected.
MONGODB_URI=mongodb://localhost:27017/shadowlens
MONGODB_DB=shadowlens

# ── API Server ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Default Models ────────────────────────────────────────────────────────────
DEFAULT_PIPELINE_MODEL=gemini/gemini-2.0-flash
